# Anthropic API key used server-side only (never exposed to the client).
ANTHROPIC_API_KEY=
# Optional: override the default model (claude-sonnet-5).
ANTHROPIC_MODEL=

# Supabase project credentials. SUPABASE_SERVICE_ROLE_KEY is preferred for
# server-side API routes; SUPABASE_ANON_KEY is a fallback for local dev.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
